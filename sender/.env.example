# Copiá este archivo como ".env" y completalo. NO lo subas a ningún lado.
PANEL_URL=https://TU-DOMINIO-DEL-PANEL
LECTOR_TOKEN=el mismo token que usa el lector (Cloudflare > Variables)
MAX_POR_CORRIDA=50
PAUSA_MIN_SEG=45
PAUSA_MAX_SEG=130
HORA_DESDE=9
HORA_HASTA=20
# Contestador (responder.py)
VENTANA=minimizada
RESP_EXTRA_SEG=10
RESP_PAUSA_MIN_SEG=25
RESP_PAUSA_MAX_SEG=70
# Cotizaciones: revisar = guarda el PDF en la carpeta "cotizaciones" y vos lo mandás; enviar = lo manda solo
COTIZ_MODO=revisar
# Modo escritorio (responder.py --escritorio): app = WhatsApp de escritorio, chrome = tu WhatsApp Web ya abierto en Chrome
ESCRITORIO=app
# Días para atrás que mira chats sin responder (1 a 14). Para ponerse al día usá 7
RESP_DIAS=3
# Sin chats para contestar, manda los seguimientos del panel (1 = sí, 0 = no) y cuántos como máximo por corrida
RESP_SEGUIMIENTOS=1
RESP_SEG_MAX=30
# Velocidad de tipeo (1 = normal, 0.6 = más rápido). Más rápido = menos humano; no bajar de 0.5
# RESP_TECLEO=0.6
