# Copiá este archivo como ".env" y completalo. NO lo subas a ningún lado.
PANEL_URL=https://cotizador.berasateguimanuel07.workers.dev
LECTOR_TOKEN=el mismo token que usa el lector (Cloudflare > Variables)
MAX_POR_CORRIDA=50
PAUSA_MIN_SEG=45
PAUSA_MAX_SEG=130
HORA_DESDE=9
HORA_HASTA=20
# Contestador (responder.py)
# oculta = fuera de la pantalla (recomendado, nadie la toca sin querer) | minimizada | visible (solo para escanear el QR)
VENTANA=oculta
RESP_EXTRA_SEG=2
RESP_PAUSA_MIN_SEG=8
RESP_PAUSA_MAX_SEG=20
# Cotizaciones: revisar = guarda el PDF en la carpeta "cotizaciones" y vos lo mandás; enviar = lo manda solo
COTIZ_MODO=revisar
# Modo escritorio (responder.py --escritorio): app = WhatsApp de escritorio, chrome = tu WhatsApp Web ya abierto en Chrome
ESCRITORIO=app
# Días para atrás que mira chats sin responder (1 a 14). 14 = lo mismo que muestra el panel
RESP_DIAS=14
# Sin chats para contestar, usa el sender unificado para los seguimientos (1 = sí, 0 = no) y cuántos como máximo por corrida
RESP_SEGUIMIENTOS=1
RESP_SEG_MAX=30
# Velocidad de tipeo (1 = normal, 0.6 = más rápido). Más rápido = menos humano; no bajar de 0.5
# RESP_TECLEO=0.6
# Prospeccion (prospectar.py): tope por dia, horario y otra sesion de WhatsApp (otro numero) si queres
PROSP_POR_DIA=20
PROSP_HORA_DESDE=10
PROSP_HORA_HASTA=19
# PROSP_PERFIL=perfil_prospeccion
